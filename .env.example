# --- Stigma server config ---

# Port the server listens on
PORT=3000

# Public URL the app is served from. Used to build absolute redirect URIs
# for OAuth, /accounts?redirect=..., etc.
PUBLIC_URL=https://stigma.example.com

# Long random string used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# Secret required to access /drive-setup and /api/backup (append as ?secret=...).
# Set a value DISTINCT from SESSION_SECRET. If unset, falls back to SESSION_SECRET;
# if neither is set, the admin routes are disabled.
ADMIN_SECRET=change-me-to-a-different-random-string

# --- Google Drive backup (optional) ---
# You can also paste the service account JSON on the secret admin page
# at /drive-setup instead of putting it here. This env var takes effect only
# if no service account has been saved via /drive-setup yet.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID of the Drive folder where daily database backups are stored.
# Strongly recommended: with the drive.file scope, files uploaded without a
# folder go to the service account's own Drive (invisible to you), so share a
# folder with the service account email and put its ID here.
GOOGLE_DRIVE_FOLDER_ID=

# --- Paynow (Zimbabwe mobile money) ---
# Get these at https://www.paynow.co.zw after creating an integration.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# --- AI provider (fill these in later, or upload your gpt file) ---
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
